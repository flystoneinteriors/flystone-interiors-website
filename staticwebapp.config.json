{
  "routes": [
    { "route": "/admin/*", "allowedRoles": ["authenticated"] },
    { "route": "/api/admin/*", "allowedRoles": ["authenticated"] }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*", "/admin/*", "/*.{css,js,png,jpg,jpeg,svg,webp,ico,txt,xml,json}"]
  }
}