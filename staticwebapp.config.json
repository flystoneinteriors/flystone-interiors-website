{
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/admin/*", "allowedRoles": ["authenticated"] },
    { "route": "/api/admin/*", "allowedRoles": ["authenticated"] }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/admin/*", "/*.{css,js,png,jpg,jpeg,webp,svg,ico,txt,xml,json}"]
  },
  "responseOverrides": { "404": { "rewrite": "/index.html" } }
}
